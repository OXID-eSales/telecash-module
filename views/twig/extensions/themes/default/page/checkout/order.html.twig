{% extends 'page/checkout/order.html.twig' %}

{% block checkout_order_btn_confirm_bottom %}
    {% if isTeleCashPayment %}
        <form id="teleCashConnectForm" method="post" action="{{ teleCashConnectUrl|raw }}">
            {{ teleCashHiddenData|raw }}
        </form>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block checkout_order_next_step_side %}
    {% if isTeleCashPayment %}
        {% include "@osc_telecash/templates/checkoutordernextstepside.html.twig" %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
