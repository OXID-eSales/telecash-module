{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate} %}

{% if readonly %}
    {% set readonly = "readonly disabled" %}
{% else %}
    {% set readonly = "" %}
{% endif %}

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}" />
    <input type="hidden" name="cl" value="{{ oViewConf.getTopActiveClassName() }}" />
</form>

{% if isTeleCashOrder is same as (true) %}
    <table id="liste" cellspacing="10" cellpadding="0" border="0"  width="98%">
            <tbody>
                <tr>
                    <td valign="top" class="edittext">
                        {% block admin_order_telecash_right_side %}
                            <table cellspacing="0" cellpadding="0" border="0">
                                <thead>
                                    <tr>
                                        <td class="edittext" colspan="2">
                                            <b>{{ translate({ ident: "OSC_TELECASH_SUMMARY_ORDER" }) }}</b>
                                        </td>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% block admin_order_telecash_summary %}
                                    <tr>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_CHARGE_TOTAL" }) }}
                                        </td>
                                        <td class="edittext">
                                            {{ format_price(chargeTotalObject, { currency: currencyObject }) }}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_PAYMENT_METHOD", suffix: "COLON" }) }}
                                        </td>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_PAYMENT_IDENT_" ~ paymentMethod }) }}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_TYPE", suffix: "COLON" }) }}
                                        </td>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_TXNTYPE_" ~ txnType }) }}
                                            {% if captureType %}
                                                ({{ translate({ ident: "OSC_TELECASH_PAYMENT_CAPTURETYPE_" ~ captureType }) }})
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="edittext">
                                            {{ translate({ ident: "OSC_TELECASH_OID", suffix: "COLON" }) }}
                                        </td>
                                        <td class="edittext">
                                            {{ oId }}
                                        </td>
                                    </tr>
                                    {% endblock %}
                                </tbody>
                            </table>
                            {% block admin_order_telecash_charge %}
                                {% if isChargePossible is same as (true) %}
                                    <br /><br />
                                    <h3>{{ translate({ ident: "OSC_TELECASH_CHARGE_HEAD" }) }}</h3>
                                    <p>{{ translate({ ident: "OSC_TELECASH_CHARGE_NOTE" }) }}</p>
                                    <form name="chargeOrder" id="chargeOrder" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
                                        {{ oViewConf.getHiddenSid()|raw }}
                                        <input type="hidden" name="oxid" value="{{ oxid }}" />
                                        <input type="hidden" name="cl" value="{{ oViewConf.getTopActiveClassName() }}" />
                                        <input type="hidden" name="fnc" value="doChargeOrder" />
                                        <label for="chargeAmount">{{ translate({ ident: "OSC_TELECASH_CHARGE_LABEL", args: currencyString, suffix: "COLON" }) }}
                                            <input
                                                id="chargeAmount"
                                                name="chargeAmount"
                                                type="text"
                                                pattern="^\d*\.?\d{0,2}$"
                                                inputmode="decimal"
                                                value="{{ chargeAmountFloat }}"
                                                title="{{ translate({ ident: "OSC_TELECASH_CHARGE_TITLE", args: chargeAmountFloat }) }}"
                                                onblur="formatAmount(this, 0, {{ chargeAmountFloat }})"
                                                oninput="validateInput(this, 0, {{ chargeAmountFloat }})"
                                            />
                                        </label>
                                        <button
                                            type="submit"
                                            aria-label="{{ translate({ ident: "OSC_TELECASH_CHARGE_SUBMIT" }) }}"
                                            title="{{ translate({ ident: "OSC_TELECASH_CHARGE_SUBMIT_HELP" }) }}"
                                        >{{ translate({ ident: "OSC_TELECASH_CHARGE_SUBMIT" }) }}
                                        </button>
                                    </form>
                                    <script>
                                    window.onload = function() {
                                        const input = document.getElementById('chargeAmount');
                                        formatAmount(input, 0, {{ chargeAmountFloat }});
                                    }
                                    function validateInput(input) {
                                        // allows only digits and decimal points
                                        input.value = input.value.replace(/[^\d.]/g, '');

                                        // Prevents multiple decimal points
                                        let parts = input.value.split('.');
                                        if (parts.length > 2) {
                                            input.value = parts[0] + '.' + parts.slice(1).join('');
                                        }

                                        // Limits decimal places to 2
                                        if (parts.length > 1) {
                                            input.value = parts[0] + '.' + parts[1].slice(0, 2);
                                        }
                                    }

                                    function formatAmount(input, min, max) {
                                        if (input.value === '' || input.value === '.') {
                                            input.value = '0.00';
                                            return;
                                        }

                                        let value = parseFloat(input.value);

                                        // Checks Min/Max limits
                                        if (isNaN(value) || value < min) {
                                            value = min;
                                        } else if (value > max) {
                                            value = max;
                                        }

                                        // Formatted to 2 decimal places
                                        input.value = value.toFixed(2);
                                    }
                                </script>
                                {% endif %}
                            {% endblock %}
                        {% endblock %}
                    </td>
                    <td valign="top" class="edittext" align="left" width="50%">
                        {% block admin_order_telecash_left_side %}
                            <table cellspacing="0" cellpadding="0" border="0">
                                <thead>
                                <tr>
                                    {% block admin_order_telecash_history_head_cnt %}
                                        <td colspan="7" class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_HISTORY" }) }}</b>
                                        </td>
                                    {% endblock %}
                                </tr>
                                <tr>
                                    {% block admin_order_telecash_history_head %}
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_DATE" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_CHARGE_TOTAL" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_STATUS" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_TYPE" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_IPG_TRANSACTION_ID" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_ENDPOINT_TRANSACTION_ID" }) }}</b>
                                        </td>
                                        <td class="edittext">
                                            <b>{{ translate({ ident: "OSC_TELECASH_TERMINAL_ID" }) }}</b>
                                        </td>
                                    {% endblock %}
                                </tr>
                                </thead>
                                {% block admin_order_telecash_history_body %}
                                    <tbody>
                                        {% for historyItem in teleCashOrderHistoryList %}
                                            <tr>
                                                {% block admin_order_telecash_history_row %}
                                                    <td class="edittext">
                                                        {{ historyItem.getTxnDate() }} {{ translate({ ident: "OSC_TELECASH_OCLOCK" }) }}
                                                    </td>
                                                    <td class="edittext">
                                                        {{ format_price(historyItem.getOxidChargeTotal(), { currency: currencyObject }) }}
                                                    </td>
                                                    <td class="edittext">
                                                        {{ historyItem.getStatus() }} ({{ translate({ ident: "OSC_TELECASH_RESPONSECODE", suffix: "COLON" }) }} {{ historyItem.getProcessorResponseCode() }})
                                                    </td>
                                                    <td class="edittext">
                                                        {{ translate({ ident: "OSC_TELECASH_TXNTYPE_" ~ historyItem.getTxnType() }) }}
                                                        {% if captureType %}
                                                            ({{ translate({ ident: "OSC_TELECASH_PAYMENT_CAPTURETYPE_" ~ captureType }) }})
                                                        {% endif %}
                                                    </td>
                                                    <td class="edittext">
                                                        {{ historyItem.getIpgTransactionId() }}
                                                    </td>
                                                    <td class="edittext">
                                                        {{ historyItem.EndpointTransactionId() }}
                                                    </td>
                                                    <td class="edittext">
                                                        {{ historyItem.getTerminalId() }}
                                                    </td>
                                                {% endblock %}
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                {% endblock %}
                            </table>
                        {% endblock %}
                    </td>
                </tr>
            </tbody>
        </table>
{% endif %}
{% include "bottomnaviitem.html.twig" %}

{% include "bottomitem.html.twig" %}
